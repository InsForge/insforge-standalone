[Unit]
Description=InsForge API (quadlet)
After=insforge-postgres.service insforge-aws-creds.service
Requires=insforge-postgres.service
# Wants, not Requires: a failed refresh keeps the last good credentials file,
# and if none was ever written the SDK falls back to IMDS. Either beats not
# starting the app.
Wants=insforge-aws-creds.service

[Container]
# Default tag mirrors docker-compose.yml on this branch; provisioning
# overwrites this line from INSFORGE_OSS_VER when the control plane pins a
# version, and `insforge-ctl upgrade <ver>` rewrites it on every upgrade.
ContainerName=insforge
# Stamped by insforge-ctl from .env / docker-compose.yml on every up and
# restart. Not a version to keep in sync: nothing starts this unit before that
# has happened, and a real tag here would just be a second place to bump.
Image=ghcr.io/insforge/insforge-oss:stamped-by-insforge-ctl
Network=insforge.network
PublishPort=7130:7130
PublishPort=7131:7131
EnvironmentFile=/etc/insforge/insforge.env
# Security patch for images built before the shared-OAuth fix; gates requests
# ahead of the application. Remove once every project runs an image with the fix.
Volume=/home/ec2-user/insforge-standalone/security-patch/insforge-security-patch.cjs:/security-patch/insforge-security-patch.cjs:ro
Environment="NODE_OPTIONS=--require /security-patch/insforge-security-patch.cjs"
LogDriver=journald
PodmanArgs=-e AWS_CLOUDFRONT_PRIVATE_KEY
# Instance-role credentials via a host-written file instead of IMDS, so the
# instance can run with an IMDS hop limit of 1 (see ../insforge-aws-creds). The
# directory is mounted, not the file: the file is replaced by rename.
Volume=/run/insforge-aws:/run/insforge-aws:ro
Environment=AWS_CONFIG_FILE=/run/insforge-aws/config
WorkingDir=/app

[Service]
Restart=always
TimeoutStartSec=600
# podman refuses a bind mount whose source is missing, and /run is emptied on
# reboot; an empty directory just means the SDK falls back to IMDS.
ExecStartPre=/bin/mkdir -p /run/insforge-aws
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do /usr/bin/pg_isready -q -h 127.0.0.1 -p 5432 && exit 0; sleep 2; done; exit 1'

[Install]
WantedBy=multi-user.target
